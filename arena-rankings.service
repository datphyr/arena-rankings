[Unit]
Description=Arena Rankings Pipeline
After=network.target clickhouse-server.service
Wants=clickhouse-server.service

[Service]
Type=simple
WorkingDirectory=/opt/arena-rankings
EnvironmentFile=/opt/arena-rankings/.env
ExecStart=/usr/bin/python3 engine.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
