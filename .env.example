# Arena Rankings — environment variables
# Copy this file to .env and fill in your values

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Twitch bot (from https://twitchapps.com/tmi/)
# TWITCH_CHANNEL supports comma-separated for multiple channels
TWITCH_BOT_TOKEN=
TWITCH_CHANNEL=
TWITCH_NICKNAME=arenabot

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=arena_rankings
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=quakepass

# Download mode: 'discovery' (default) or 'sequential'
#   discovery  — matchlist discovery registers match IDs, downloader fetches
#                only those match pages (efficient, chronological sort_time)
#   sequential — scan /post/1..N and store every page (robust fallback)
# DOWNLOAD_MODE=discovery

# Logging (optional)
# LOG_LEVEL=DEBUG            # DEBUG, INFO, WARNING, ERROR
# LOG_FILE=                  # full path to a rotating log file (in addition to stdout)
# LOG_DIR=                   # directory; log file = <dir>/arena.log (alternative to LOG_FILE)